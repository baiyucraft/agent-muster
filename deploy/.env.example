DEPLOY_SSH_TARGET=agent-muster-hub
DEPLOY_REMOTE_DIR=/home/ubuntu/agent-muster
DEPLOY_BRANCH=main

# Compose 部署默认在宿主机监听 HTTP 13011。可填写具体网卡地址限制监听范围。
MUSTER_BIND_ADDRESS=0.0.0.0
MUSTER_HTTP_PORT=13011
# 生成两个不同的随机令牌，例如分别运行 openssl rand -hex 32。
MUSTER_ADMIN_TOKEN=
MUSTER_DSH_PLUGIN_TOKEN=
# 内置 PostgreSQL。使用十六进制密码，避免 URL 转义；首次创建数据库卷时生效。
MUSTER_POSTGRES_PASSWORD=
# 外接 PostgreSQL。只在使用 -f compose.yaml 时填写，URL 内的特殊字符须编码。
MUSTER_DATABASE_URL=
# 中心 dsh 使用的模型凭据，只传给 dsh 服务。
DEEPSEEK_API_KEY=

# 可选。由 Hub 使用飞书自建应用单独向此 Open ID 发送请示卡片。
MUSTER_FEISHU_APP_ID=
MUSTER_FEISHU_APP_SECRET=
MUSTER_FEISHU_OPEN_ID=

# 以下 MUSTER_RTC_* 变量设置在 Hub 服务进程的运行环境中。
# 未设置时使用默认 STUN，显式空值关闭 STUN。
# MUSTER_RTC_STUN_URLS=stun:stun.l.google.com:19302
# 指定单笔验收投递 ID，留空关闭设备连接诊断。
# MUSTER_RTC_DIAGNOSTIC_TRANSFER_ID=
# 与验收投递同时配置为 1 时，由限定了对应投递和期限的签名设备包尝试临时 IPv4 UDP 映射。
# MUSTER_RTC_DIAGNOSTIC_PORT_MAPPING=

# 指定允许双方首次登记信令公钥的验收投递，留空停用登记入口。
# 通过 HTTP 首次登记后，使用可信带外渠道核对双方公钥指纹。
# MUSTER_RTC_KEY_TRANSFER_ID=
# TURN 公网地址与逗号分隔的获准设备 ID。
# MUSTER_RTC_TURN_URLS=turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp
# MUSTER_RTC_TURN_DEVICE_IDS=
# Hub 和 Coturn 使用同一个 64 字符小写十六进制密钥字符串，与静态凭据配置互斥。
# MUSTER_RTC_TURN_REST_SECRET=
# 非 REST 模式下，使用已配置 TURN 的静态账号。
# MUSTER_RTC_TURN_USERNAME=
# MUSTER_RTC_TURN_CREDENTIAL=
